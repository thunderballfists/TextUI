<ui>
  <style src="controls.tcss" />
  <script src="controller.py" />
  <vertical id="demo">
    <label>Native form controls</label>
    <tabbed-content id="tabs" initial="form" on-tab-activated="tab_changed">
      <tab-pane id="form" title="Form">
        <select id="status" autofocus="true" prompt="Status" value="new" allow-blank="false" on-changed="status_changed">
          <option value="new">New</option>
          <option value="done">Done</option>
        </select>
        <switch id="enabled" value="false" on-changed="enabled_changed" />
        <text-area id="notes" soft-wrap="true" on-changed="notes_changed">Start typing here.</text-area>
      </tab-pane>
      <tab-pane id="about" title="About">
        <label>Tabs and controls are native Textual widgets.</label>
      </tab-pane>
      <tab-pane id="indicators" title="Indicators">
        <radio-set id="choice" on-changed="priority_changed">
          <radio-button id="low">Low</radio-button>
          <radio-button id="high" value="true">High</radio-button>
        </radio-set>
        <rule line-style="dashed" />
        <progress-bar id="work" total="100" progress="25" show-eta="false" />
        <range id="volume" min="0" max="100" step="5" value="40" show-value="true" on-changed="volume_changed" />
        <collapsible id="details" title="Details" collapsed="true" on-collapsed="details_collapsed" on-expanded="details_expanded">
          <label>Textual handles pointer and keyboard input.</label>
        </collapsible>
      </tab-pane>
    </tabbed-content>
    <label id="feedback">Ready</label>
  </vertical>
</ui>
