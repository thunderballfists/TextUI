#showcase { height: 100%; }
#top-bar {
  background: linear-gradient(90deg, #173b6c, #376996, #12233d);
  color: white;
}
#showcase Button { min-width: 0; }
#layout { height: 1fr; }
#content { height: 1fr; }
#sidebar { width: 22; }
#sidebar-menu { height: 100%; }
#navigation { height: 1fr; }
#quit { width: 100%; }
#usage { height: 8; }
#jobs, #files { width: 1fr; height: 12; }
#transcript { height: 10; }
.agent-card { padding: 1; border: round $primary; margin: 1 0; }
